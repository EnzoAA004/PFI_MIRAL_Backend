<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>ar.edu.uade.pfi</groupId>
  <artifactId>pfi-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>PFI Backend</name>
  <description>Standalone Spring Boot backend for the PFI AI service integration.</description>

  <developers>
    <developer>
      <email>xxxx.com</email>
      <name>Enzo Asplanatti</name>
      <id>enzo.asplanatti</id>
    </developer>
    <developer>
      <email>franciscofabrelo@gmail.com</email>
      <name>Francisco Fabrello</name>
      <id>fabrello.francisco</id>
    </developer>
  </developers>

  <properties>
    <!-- Final release target. Ver docs/migrations y Dockerfile: el runtime de CI/Docker
         tiene que coincidir con este valor. -->
    <java.version>21</java.version>
    <maven.version>3.8.3</maven.version>

    <postgresql.version>42.7.12</postgresql.version>
    <guava.version>33.7.2-jre</guava.version>
    <opentelemetry.version>1.67.0</opentelemetry.version>
    <!-- Spring Boot 4.x uses Springdoc OpenAPI 3.x. -->
    <springdoc-openapi.version>3.2.0</springdoc-openapi.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <wiremock-standalone.version>3.13.2</wiremock-standalone.version>

    <!-- 0.8.12 es la linea de JaCoCo que soporta el bytecode de Java 21. -->
    <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
  </properties>

  <dependencies>
    <!-- General dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webclient</artifactId>
    </dependency>
    <!--
      Brings HikariCP at Spring Boot's managed, compatible version. Only the
      DataSource/pooling machinery is used: DataSourceAutoConfiguration is
      excluded in AiBackendApplication, and PfiDataSourceConfig builds the one
      pooled DataSource this app uses.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${postgresql.version}</version>
    </dependency>
    <!--
      Cloud SQL Java Connector (PostgreSQL socket factory). No JDBC URL/code path
      changes needed: every PostgresXxxRepository/Service's toJdbcUrl() already
      passes a jdbc:postgresql://... string through unchanged, and
      "jdbc:postgresql:///{db}?cloudSqlInstance=...&socketFactory=..." matches that
      same prefix. This dependency only puts the SocketFactory class the driver
      looks up by name on the classpath. Auth is ADC via the Cloud Run runtime
      service account, already granted roles/cloudsql.client: no service-account
      JSON, no VPC connector, no public-IP TCP connection.
    -->
    <dependency>
      <groupId>com.google.cloud.sql</groupId>
      <artifactId>postgres-socket-factory</artifactId>
      <version>1.20.1</version>
    </dependency>
    <!--
      Documentacion OpenAPI generada desde el propio codigo. Se prefiere que la
      referencia de la API salga de los controllers y DTOs reales y no de un documento
      escrito a mano, que envejece sin que nadie se entere.
    -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc-openapi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.3</version>
    </dependency>
    <dependency>
      <groupId>com.google.auth</groupId>
      <artifactId>google-auth-library-oauth2-http</artifactId>
      <version>1.49.0</version>
    </dependency>
    <!--
      GCS provider for ObjectStorageService: code-ready, not deployed. Uses
      Application Default Credentials only (no service-account JSON), same
      auth posture as google-auth-library-oauth2-http above.
    -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
      <version>2.45.0</version>
    </dependency>
    <!-- CVE-2026-102554: keep Google's transitive Guava on the patched compatible line. -->
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>${guava.version}</version>
    </dependency>
    <!-- CVE-2026-118259: use the patched OTel API while Boot 4 manages the SDK. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${opentelemetry.version}</version>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webclient-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock-standalone.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Cobertura. Todavia sin `check`: primero se mide y despues se decide si conviene un
        umbral y en que nivel. Poner un numero antes de conocer el baseline solo consigue que
        el CI falle por una cifra elegida a dedo.

        No hay exclusiones. Los DTOs son en su mayoria records, que aportan metodos sinteticos
        (equals, hashCode, toString) que nadie testea a proposito; excluirlos subiria el numero
        global sin que nadie escriba un test mas. Se prefiere leer la cobertura por paquete,
        donde esa distorsion se ve en vez de esconderse.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-instrument</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!--
            En `verify` y no en `test`: surefire tiene que haber terminado de escribir
            jacoco.exec antes de que se genere el reporte. Atado a `test` el reporte sale
            de la corrida anterior, que es peor que no tenerlo.
          -->
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
